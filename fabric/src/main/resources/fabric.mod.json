{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "${homepage}",
        "issues": "${issues}"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "org.js.lolifamily.minecraftmcp.MinecraftMcp"
        ]
    },
    "mixins": [
        "minecraft_mcp.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "minecraft": "${fabric_minecraft_version_range}",
        "java": ">=${bytecode_version}"
    }
}
  